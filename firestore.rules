rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /alerts/{alertId} {
      // Anyone with the app can read alerts (the app filters by distance on-device).
      allow read: if true;
      // An alert can be created once — either by her phone ("direct") or by the first
      // gateway phone that relayed it over the mesh ("mesh"). Never edited or deleted,
      // which is what guarantees only one gateway texts her contact.
      allow create: if request.resource.data.keys().hasOnly(
                         ['lat', 'lng', 'accuracy', 'cell', 'senderId', 'createdAt',
                          'sentAt', 'via', 'hops', 'gateway'])
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.cell is string
                    && request.resource.data.senderId is string
                    && request.resource.data.createdAt is timestamp
                    && (!('via' in request.resource.data) || request.resource.data.via in ['direct', 'mesh'])
                    && (!('hops' in request.resource.data) || request.resource.data.hops is int);
      allow update, delete: if false;
    }
  }
}
