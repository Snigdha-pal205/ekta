rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /alerts/{alertId} {
      function data() { return request.resource.data; }
      function keyHash() { return hashing.sha256(data().statusKey).toHexString().lower(); }
      function changed() { return data().diff(resource.data).affectedKeys(); }
      // A location point older than the one stored can never replace it.
      function newerPoint() {
        return data().statusAt is int && data().statusAt >= resource.data.get('statusAt', 0);
      }

      // Anyone with the app can read alerts (the app filters by distance on-device).
      allow read: if true;

      // An alert is created once — by her phone ("direct") or by the first gateway
      // phone that relayed it over the mesh ("mesh").
      allow create: if data().keys().hasOnly(
                         ['lat', 'lng', 'accuracy', 'cell', 'senderId', 'createdAt',
                          'sentAt', 'via', 'hops', 'gateway', 'status', 'hashC', 'hashD',
                          'hashL', 'statusAt'])
                    && data().lat is number
                    && data().lng is number
                    && data().cell is string
                    && data().senderId is string
                    && data().createdAt is timestamp
                    && (!('via' in data()) || data().via in ['direct', 'mesh'])
                    && (!('hops' in data()) || data().hops is int)
                    && (!('status' in data()) || data().status == 'active');

      // Ending an alert with a PIN. Only possible with the secret key whose hash came
      // with the SOS: "cancelled" needs the cancel key, "duress" the duress key.
      // A cancelled alert is final; it can never become active or duress again.
      allow update: if
          (
            resource.data.get('status', 'active') == 'active'
            && changed().hasOnly(['status', 'statusKey', 'statusAt', 'lat', 'lng', 'accuracy'])
            && data().statusKey is string
            && (
              (data().status == 'cancelled' && keyHash() == resource.data.get('hashC', '-'))
              || (data().status == 'duress' && keyHash() == resource.data.get('hashD', '-'))
            )
          )
          // "I'm safe now" after a duress: she ends it for real with her normal PIN.
          // Needs the CANCEL key (the duress key, already revealed, can't do this).
          || (
            resource.data.get('status', 'active') == 'duress'
            && data().status == 'cancelled'
            && changed().hasOnly(['status', 'statusKey', 'statusAt', 'lat', 'lng', 'accuracy'])
            && data().statusKey is string
            && keyHash() == resource.data.get('hashC', '-')
          )
          // While in duress, her live location keeps updating.
          || (
            resource.data.get('status', 'active') == 'duress'
            && changed().hasOnly(['lat', 'lng', 'accuracy', 'statusAt'])
            && data().lat is number && data().lng is number
            && newerPoint()
          )
          // While active, her live location keeps updating — only with the location
          // key whose hash came with the SOS.
          || (
            resource.data.get('status', 'active') == 'active'
            && changed().hasOnly(['lat', 'lng', 'accuracy', 'statusAt', 'locKey'])
            && data().lat is number && data().lng is number
            && data().locKey is string
            && hashing.sha256(data().locKey).toHexString().lower() == resource.data.get('hashL', '-')
            && newerPoint()
          );

      allow delete: if false;
    }
  }
}
